    { "Username": "<שם משתמש למנהלת הצוות>", "DisplayName": "<השם שיוצג, למשל חנה>", "Password": "<סיסמה זמנית, 10 תווים לפחות>", "Email": "<המייל של מנהלת הצוות>", "Role": "TeamLead" },
    { "Username": "<שם משתמש למנהלת>", "DisplayName": "<השם שיוצג>", "Password": "<סיסמה זמנית, 10 תווים לפחות>", "Email": "<המייל של המנהלת>", "Role": "Manager" }
